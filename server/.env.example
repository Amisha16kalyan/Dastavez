PORT=1234
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# AI Writing Assistant Configuration
# Supported providers: gemini (default) | openai
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# Provide your API key (Gemini API Key or OpenAI API Key):
LLM_API_KEY=your_llm_api_key_here

# When no API key is provided, enable intelligent local demo assistant (true / false)
AI_MOCK_FALLBACK=true
