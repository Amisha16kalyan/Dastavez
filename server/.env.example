PORT=1234
CORS_ORIGIN=https://dastavez-eight.vercel.app,http://localhost:3000,http://localhost:5173,http://localhost:3001

# Postgres connection (pooled URL is preferred by the server if set)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_POOLED=postgresql://user:password@host-pooler/dbname?sslmode=require

# AI Writing Assistant Configuration
# Supported providers: gemini (default) | openai
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# Provide your API key (Gemini API Key or OpenAI API Key):
LLM_API_KEY=your_llm_api_key_here

# When no API key is provided, enable intelligent local demo assistant (true / false)
AI_MOCK_FALLBACK=true
